# Supabase - Get these from your project's Connect dialog or API Settings
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend / MCP - Cart and checkout use UCP endpoints (see FRONTEND_CART_CHECKOUT_API.md)
# If unset, falls back to NEXT_PUBLIC_API_BASE_URL (e.g. same server as chat)
NEXT_PUBLIC_MCP_BASE_URL=http://localhost:8001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
